      "parameters": {
        "jsCode": "const output = $input.first().json.output;\nconst match = output.match(/CHATID:(\\d+)/);\nconst chatId = match ? match[1] : '';\nconst text = output.replace(/\\n*CHATID:\\d+/, '').trim();\n\nreturn [{ json: { chatId: chatId, text: text } }];"
      },
