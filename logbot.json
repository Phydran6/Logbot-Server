    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst chatId = $('Ich frage nach den aktuellen Logs').first().json.message.chat.id;\nconst logs = items.map(i => i.json);\nconst count = logs.length;\n\nlet text = \"Log-Analyse (\" + count + \" Eintraege)\\n\\n\";\n\nfor (const log of logs) {\n  text += \"[\" + log.timestamp + \"] \" + log.level.toUpperCase() + \" - \" + log.hostname + \"\\n\";\n  text += log.message + \"\\n\\n\";\n}\n\nreturn [{ json: { message: text, count: count, chatId: String(chatId) } }];"
      },
