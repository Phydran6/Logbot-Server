# LogBot Konfiguration
# Kopiere diese Datei zu .env und passe die Werte an:
#   cp .env.example .env
#
# Oder führe install.sh aus – das generiert .env automatisch.

# Datenbank
DB_USER=logbot
DB_PASSWORD=CHANGE_ME
DB_NAME=logbot

# --- Externe Datenbank (optional) --------------------------------------------
# Standard: der mitgelieferte Postgres-Container. Sollen die Daten auf einem
# eigenen Datenbankserver liegen (LogBot laeuft dann nur noch als Anwendung),
# hier den Server eintragen und mit dem Zusatz-Compose starten:
#   docker compose -f docker-compose.yml -f docker-compose.external-db.yml up -d
# Anleitung steht oben in docker-compose.external-db.yml.
#
# Variante A - Einzelwerte:
# DB_HOST=db.example.com
# DB_PORT=5432
#
# Variante B - alles in einer Zeile (hat Vorrang):
# DATABASE_URL=postgresql://logbot:passwort@db.example.com:5432/logbot
#
# Verschluesselte Verbindung: Pflicht, sobald die Datenbank nicht im selben
# Docker-Netz steht. Werte: require, verify-ca, verify-full
# DB_SSLMODE=require

# PostgreSQL-Major-Version (Docker-Tag). Standard: 17 (neu + stabil).
# Neuinstallation: einfach so lassen.
# Bestehende 16er-DB: erst datenerhaltend migrieren (bash db/migrate.sh)
#   ODER voruebergehend POSTGRES_VERSION=16 setzen, damit alles weiterlaeuft.
POSTGRES_VERSION=17

# JWT Secret für API-Authentifizierung (mind. 32 zufällige Zeichen)
JWT_SECRET=CHANGE_ME

# Öffentliche URL des Servers (wichtig für QR-Code-Generierung!)
# Ohne diesen Wert wird das Protokoll aus dem internen Request abgeleitet
# (hinter Caddy/Reverse Proxy immer http statt https)
SITE_URL=https://deine-domain.de

# --- Patchmanagement (System -> Updates) --------------------------------------
# Wo die Installation auf dem HOST liegt. Muss stimmen, sonst findet das
# Update-Skript die docker-compose.yml nicht.
LOGBOT_INSTALL_DIR=/opt/logbot
# Repository und Branch, gegen die geprueft wird (z.B. fuer eigene Forks).
LOGBOT_REPO_SLUG=Phydran6/Logbot-Server
LOGBOT_BRANCH=main
# Optional: GitHub erlaubt ohne Token nur 60 Abfragen pro Stunde.
# GITHUB_TOKEN=ghp_xxx
# Optional: Anzahl aufbewahrter Sicherungen (in <install>-backups)
# LOGBOT_KEEP_BACKUPS=5
