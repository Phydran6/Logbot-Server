# LogBot Konfiguration
# Kopiere diese Datei zu .env und passe die Werte an:
#   cp .env.example .env
#
# Oder führe install.sh aus – das generiert .env automatisch.

# Datenbank
DB_USER=logbot
DB_PASSWORD=CHANGE_ME
DB_NAME=logbot

# --- Externe Datenbank (optional) --------------------------------------------
# Standard: der mitgelieferte Postgres-Container. Sollen die Daten auf einem
# eigenen Datenbankserver liegen (LogBot laeuft dann nur noch als Anwendung),
# hier den Server eintragen und mit dem Zusatz-Compose starten:
#   docker compose -f docker-compose.yml -f docker-compose.external-db.yml up -d
# Anleitung steht oben in docker-compose.external-db.yml.
#
# Variante A - Einzelwerte:
# DB_HOST=db.example.com
# DB_PORT=5432
#
# Variante B - alles in einer Zeile (hat Vorrang):
# DATABASE_URL=postgresql://logbot:passwort@db.example.com:5432/logbot
#
# Verschluesselte Verbindung: Pflicht, sobald die Datenbank nicht im selben
# Docker-Netz steht. Werte: require, verify-ca, verify-full
# DB_SSLMODE=require

# PostgreSQL-Major-Version (Docker-Tag). Standard: 17 (neu + stabil).
# Neuinstallation: einfach so lassen.
# Bestehende 16er-DB: erst datenerhaltend migrieren (bash db/migrate.sh)
#   ODER voruebergehend POSTGRES_VERSION=16 setzen, damit alles weiterlaeuft.
POSTGRES_VERSION=17

# JWT Secret für API-Authentifizierung (mind. 32 zufällige Zeichen)
JWT_SECRET=CHANGE_ME

# Öffentliche URL des Servers (wichtig für QR-Code-Generierung!)
# Ohne diesen Wert wird das Protokoll aus dem internen Request abgeleitet
# (hinter Caddy/Reverse Proxy immer http statt https)
SITE_URL=https://deine-domain.de

# --- Patchmanagement (System -> Updates) --------------------------------------
# Wo die Installation auf dem HOST liegt. Muss stimmen, sonst findet das
# Update-Skript die docker-compose.yml nicht.
LOGBOT_INSTALL_DIR=/opt/logbot
# Repository und Branch, gegen die geprueft wird (z.B. fuer eigene Forks).
LOGBOT_REPO_SLUG=Phydran6/Logbot-Server
LOGBOT_BRANCH=main
# Optional: GitHub erlaubt ohne Token nur 60 Abfragen pro Stunde.
# GITHUB_TOKEN=ghp_xxx
# Optional: Anzahl aufbewahrter Sicherungen (in <install>-backups)
# LOGBOT_KEEP_BACKUPS=5

# =============================================================================
# Sofortmeldung bei neuem Stand (System -> Updates)
# =============================================================================
# Der Server sieht selbst nach, ob auf GitHub etwas Neues liegt, und meldet es
# sofort in jedes offene Fenster. Takt in Sekunden.
LOGBOT_UPDATE_WATCH=true
LOGBOT_UPDATE_WATCH_INTERVAL=120
# Noch schneller geht es mit einem GitHub-Webhook: diesen Wert im Repository
# unter Settings -> Webhooks als Secret eintragen, Ereignis "push", Ziel
#   https://<dein-logbot>/api/updates/webhook
# OHNE gesetztes Secret nimmt der Server gar keine Webhook-Meldung an.
# LOGBOT_WEBHOOK_SECRET=CHANGE_ME

# =============================================================================
# Sicherungen (System -> Sicherung)
# =============================================================================
# Liegen in einem eigenen Docker-Volume und ueberstehen so einen Neubau der
# Container. Wie viele aufgehoben werden:
LOGBOT_KEEP_BACKUPS=10

# =============================================================================
# Konsole im Browser (System -> Konsole)
# =============================================================================
# Eine echte Shell auf DIESEM Server, wie die Konsole in Proxmox VE. Sie laeuft
# als root auf dem Host, nicht im Container.
#
# Standardmaessig AN. Das klingt gewagt, ist aber die ehrlichere Einstellung:
# Wer diese Oberflaeche als Administrator erreicht, kann ohnehin Updates
# einspielen, Container neu bauen und den Host neu starten - also in jedem Fall
# Code auf diesem Server ausfuehren. Ein Schalter davor hat keinen Angreifer
# aufgehalten, nur den Betreiber. Jede Sitzung steht mit Benutzer, Uhrzeit und
# Dauer im Systemtagebuch.
#
# Wer sie trotzdem nicht will: auf false setzen. Dann gibt es sie schlicht nicht.
LOGBOT_WEBSHELL=true
LOGBOT_WEBSHELL_MAX_SESSIONS=3
LOGBOT_WEBSHELL_IDLE_TIMEOUT=900

# =============================================================================
# Plattenwaechter (Verwaltung -> Daten & Aufbewahrung -> Speicherplatz)
# =============================================================================
# Raeumt auf, BEVOR es eng wird. Die Vorgaengerfassung wartete bis 90 % und rief
# dann VACUUM FULL - das braucht noch einmal so viel Platz, wie die Tabelle gross
# ist, und scheiterte deshalb genau dann, wenn es gebraucht wurde. Ab 95 % half
# nur noch "alle Logs weg".
#
# Jetzt: haeufiger nachsehen, frueher anfangen, in Haeppchen loeschen, und die
# letzten Stunden bleiben immer stehen.
#
# DISK_MONITOR_INTERVAL=60        # wie oft nachgesehen wird (Sekunden)
# DISK_USAGE_WARN=80              # ab hier wird aufgeraeumt
# DISK_USAGE_HIGH=88              # ab hier wird es ernst
# DISK_USAGE_THRESHOLD=93         # ab hier mit Nachdruck
# DISK_USAGE_TARGET=75            # so weit soll es wieder herunter
# DISK_MIN_KEEP_HOURS=24          # so viel bleibt IMMER stehen
# DISK_CLEANUP_BATCH=50000        # Zeilen je Loeschhaeppchen
# DISK_ALLOW_TRUNCATE=false       # "alle Logs weg" von selbst? Bewusst nein.

# =============================================================================
# Anmeldung ueber Microsoft 365 / Entra ID (Verwaltung -> Single Sign-on)
# =============================================================================
# Eingerichtet wird das vollstaendig in der Oberflaeche - Mandant, Anwendungs-ID
# und Client-Geheimnis stehen in der Datenbank, nicht hier. Es braucht KEINEN
# kostenpflichtigen Entra-Plan: LogBot nimmt OpenID Connect, und eine
# App-Registrierung damit ist in jedem Microsoft-365-Tarif enthalten.
#
# Damit die Rueckadresse stimmt, sollte SITE_URL oben gesetzt sein.

# =============================================================================
# Sprache
# =============================================================================
# Vorgabe fuer die Oberflaeche, wenn der Browser nichts anderes verlangt (de|en).
LOGBOT_DEFAULT_LANGUAGE=de

# =============================================================================
# Zusatzdienste (System -> Zusatzdienste)
# =============================================================================
# Erst aktiv, wenn deploy/optional.yml mitgelesen wird UND das Profil an ist:
#   COMPOSE_FILE=docker-compose.yml:deploy/optional.yml
#   COMPOSE_PROFILES=portainer,tugtainer
# Beides schreibt der Installer bzw. die Oberflaeche selbst.
#
# Die Passwoerter wuerfelt der Installer aus; einsehbar sind sie im Web-UI
# unter System -> Zusatzdienste.
# PORTAINER_ADMIN_PASSWORD=CHANGE_ME
# PORTAINER_BIND=127.0.0.1
# PORTAINER_PORT=9000
# N8N_USER=admin
# N8N_PASSWORD=CHANGE_ME
# N8N_ENCRYPTION_KEY=CHANGE_ME
# N8N_BIND=127.0.0.1

# Tugtainer - prueft, ob fuer die FREMDEN Images (postgres, caddy, ...) Updates
# bereitliegen. Es loest Watchtower ab, und zwar bewusst: Watchtower hat die
# Container selbst ausgetauscht, nachts und ohne Ansage. Tugtainer meldet nur.
# Der Docker-Socket ist deshalb standardmaessig nur LESBAR eingehaengt - damit
# kann dieser Container gar nichts austauschen, selbst wenn ihn jemand
# umstellt. Wer das anders will: TUGTAINER_SOCKET_MODE=rw.
# TUGTAINER_AGENT_SECRET=CHANGE_ME
# TUGTAINER_BIND=127.0.0.1
# TUGTAINER_PORT=9412
# TUGTAINER_SOCKET_MODE=ro

# Open WebUI - KI-Oberflaeche. Interessant, weil dahinter ein LOKALES Modell
# haengen kann (Ollama): dann verlaesst bei der KI-Auswertung keine Logzeile
# den Server. Ollama selbst ist bewusst nicht Teil dieses Stacks - ein
# Sprachmodell will Arbeitsspeicher und moeglichst eine Grafikkarte.
# OPENWEBUI_SECRET_KEY=CHANGE_ME
# OPENWEBUI_BIND=127.0.0.1
# OPENWEBUI_PORT=3000
# OLLAMA_BASE_URL=http://192.168.1.50:11434

# POSTFIX_HOSTNAME=logbot.example.com
